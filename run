#!/usr/bin/env bash
# rmlive launcher. Run from anywhere; talks to the tablet over USB via the
# `remarkable` ssh alias (override with RM_HOST).
#
#   ./run [start] [--prof] [interval_ms]   build, deploy if changed, (re)start, open viewer
#   ./run app                              build and open just the viewer app (RMLIVE_BROWSER=1: use the browser)
#   ./run stop                             stop the streamer on the tablet
#   ./run status                           running? which frame? last log lines
#   ./run log                              tail the tablet-side log
#   ./run prof                             pull profiling logs and summarize them
#   ./run bench                            deploy and time read/hash/encode on the tablet
#   ./run put [--replace] [--folder F] FILE.pdf|URL ...
#                                          upload PDFs/EPUBs (local or URL) to the tablet; --folder
#                                          puts them in F, --replace swaps out the same-named doc
#   ./run ls                               list documents on the tablet, newest first
#   ./run get [-o DIR] [--palette projector|FILE] NAME|ID|--last ...
#                                          download documents as PDFs, ink included
set -euo pipefail
CALLER_PWD=$PWD
cd "$(dirname "$0")"
REPO=$PWD

HOST=${RM_HOST:-remarkable}
URL=http://10.11.99.1:8099/
BIN=target/aarch64-unknown-linux-musl/release/rmlive
REMOTE=/home/root/rmlive

# macOS: SDK resolution picks the newest installed SDK, which can outpace the
# active clang/ld when CLT versions are stacked (fresh machines, Oct 2026:
# 26-era linker + 27.0 SDK -> "unknown architecture arm64e.x1" in the SDK's
# .tbd files). Pin to the default SDK symlink under the active developer dir,
# which pairs with the active toolchain. Harmless when they already agree.
if [[ -z ${SDKROOT:-} ]] && devdir=$(xcode-select -p 2>/dev/null) && [[ -d $devdir/SDKs/MacOSX.sdk ]]; then
  export SDKROOT=$devdir/SDKs/MacOSX.sdk
fi
ssh_rm() { ssh -o ConnectTimeout=5 -o LogLevel=ERROR "$HOST" "$@"; }

WEB=http://10.11.99.1
check_web() {
  if ! curl -s -m 3 -o /dev/null "$WEB/documents/"; then
    cat >&2 <<EOF
The tablet's USB web interface isn't answering. With the cable plugged in,
toggle the "USB web interface" setting off and back on (it can read "on"
without the server actually running), then retry.
EOF
    exit 1
  fi
}

check_tablet() {
  if ! ssh_rm true 2>/dev/null; then
    cat >&2 <<EOF
Can't reach the tablet ($HOST). Check:
  - USB cable plugged in, tablet awake and unlocked
  - macOS: System Settings > Privacy & Security > Local Network has your
    terminal app enabled (toggle off/on if it already is). Missing
    permission shows up as "No route to host" even though the link is up.
EOF
    exit 1
  fi
}

build_and_deploy() {
  cargo build --release --quiet
  local here there
  here=$(shasum -a 256 "$BIN" | cut -d' ' -f1)
  there=$(ssh_rm "sha256sum $REMOTE 2>/dev/null | cut -d' ' -f1" || true)
  if [[ "$here" != "$there" ]]; then
    echo "deploying new build to $HOST:$REMOTE"
    scp -q -o LogLevel=ERROR "$BIN" "$HOST:$REMOTE.new"
    ssh_rm "chmod +x $REMOTE.new && mv $REMOTE.new $REMOTE"
  fi
}

# The viewer app (mac/). Rebuilt only when its sources change, since every
# ad-hoc-signed build is a new identity to macOS's Local Network prompt.
APP=target/rmlive.app
build_app() {
  local exe=$APP/Contents/MacOS/rmlive
  if [[ ! -x $exe || mac/main.swift -nt $exe || mac/Info.plist -nt $exe ]]; then
    echo "building $APP"
    mkdir -p "$APP/Contents/MacOS"
    cp mac/Info.plist "$APP/Contents/"
    swiftc -O -o "$exe" mac/main.swift
    codesign --force --sign - "$APP" 2>/dev/null
  fi
}

open_viewer() {
  if [[ -n ${RMLIVE_BROWSER:-} ]] || ! build_app; then
    open "$URL"
  else
    open "$APP"
  fi
}

cmd=${1:-start}
[[ $# -gt 0 ]] && shift

case "$cmd" in
  start)
    check_tablet
    build_and_deploy
    # shellcheck disable=SC2029  # args are meant to expand locally
    ssh_rm "killall rmlive 2>/dev/null; sleep 0.3; cd /home/root && nohup ./rmlive $* >/tmp/rmlive.log 2>&1 &"
    for _ in $(seq 1 25); do
      curl -s -m 1 -o /dev/null "$URL" && break
      sleep 0.2
    done
    if ! curl -s -m 1 -o /dev/null "$URL"; then
      echo "streamer didn't come up; log:" >&2
      ssh_rm 'cat /tmp/rmlive.log' >&2
      exit 1
    fi
    ssh_rm 'cat /tmp/rmlive.log'
    open_viewer
    ;;
  app)
    open_viewer
    ;;
  stop)
    check_tablet
    ssh_rm 'killall rmlive 2>/dev/null && echo stopped || echo "not running"'
    ;;
  status)
    check_tablet
    ssh_rm 'if pidof rmlive >/dev/null; then echo "running: $(tr "\0" " " </proc/$(pidof rmlive)/cmdline)"; else echo "not running"; fi; echo "--- /tmp/rmlive.log"; tail -n 5 /tmp/rmlive.log 2>/dev/null'
    echo "viewer: $URL"
    ;;
  log)
    check_tablet
    ssh_rm 'tail -n 50 /tmp/rmlive.log'
    ;;
  prof)
    check_tablet
    dir="prof/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$dir"
    for f in rmlive-prof.jsonl rmlive-client.jsonl rmlive.log; do
      scp -q -o LogLevel=ERROR "$HOST:/tmp/$f" "$dir/" 2>/dev/null || echo "missing /tmp/$f (was it started with --prof?)" >&2
    done
    python3 -I tools/analyze_prof.py "$dir"
    echo "raw logs: $dir"
    ;;
  bench)
    check_tablet
    build_and_deploy
    ssh_rm "$REMOTE --bench"
    ;;
  put)
    check_web
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    args=() failed=
    while [[ $# -gt 0 ]]; do
      src=$1; shift
      case "$src" in
        --replace) args+=("$src") ;;
        --folder) args+=("$src" "${1:?--folder needs a name}"); shift ;;
        http://*|https://*)
          f="$tmp/$(basename "${src%%\?*}")"
          if curl -sSfL -m 60 -o "$f" "$src"; then args+=("$f"); else echo "download failed: $src" >&2; failed=1; fi ;;
        /*) args+=("$src") ;;
        *) args+=("$CALLER_PWD/$src") ;;
      esac
    done
    python3 -I tools/rmdocs.py put "${args[@]}" && [[ -z $failed ]]
    ;;
  ls)
    check_web
    python3 -I tools/rmdocs.py ls
    ;;
  get)
    check_web
    (cd "$CALLER_PWD" && python3 -I "$REPO/tools/rmdocs.py" get "$@")
    ;;
  *)
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
